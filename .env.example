# Copy to .env and replace both placeholder values. Keep .env out of Git.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# URL-encode special characters in the password part of DATABASE_URL.
DATABASE_URL=postgresql://radar:replace-with-a-long-random-password@db:5432/radar
COLLECT_INTERVAL_SECONDS=60
# Opt-in pool context lookup, capped per API worker lifetime. Keep behind trusted access.
DEX_LOOKUP_ENABLED=false
DEX_LOOKUP_MAX_REQUESTS=100
# Shared UTC-day ceiling when DATABASE_URL is configured; survives API restarts.
DEX_LOOKUP_DAILY_REQUESTS=100
DEX_SCAN_INTERVAL_SECONDS=900
# Keep the whole alert profile disabled until a deliberate operator opt-in.
RADAR_ALERTS_ENABLED=false
# Sending needs --send AND this opt-in. Keep credentials only in private secret configuration.
TELEGRAM_SEND_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DAILY_ATTEMPTS=100
# Queue operational notices independently of the Telegram send setting.
ALERT_DATA_QUALITY_ENABLED=false
# Optional discovery profile; independent daily feed budget and shared pool budget.
PROFILE_POLL_SECONDS=3600
PROFILE_DAILY_REQUESTS=24
PROFILE_MAX_POOL_SCANS=3
# Bounded read-only public mainnet authority evidence. Requires DATABASE_URL.
SOLANA_AUTHORITIES_ENABLED=false
SOLANA_AUTHORITY_DAILY_REQUESTS=100
# Optional paper profile: existing predeclared plan ID under private work/paper-plans.
PAPER_PLAN_ID=
# Optional read-only forward research status in API (/research or /research/forward-plans).
RESEARCH_STATUS_ROOT=
RESEARCH_STATUS_PLAN_IDS=
# Local processes may opt in; Compose uses internal Redis with no published port.
REDIS_URL=
# Generate privately for deployment; dashboard forwards this server-side only.
RADAR_API_TOKEN=
# Keep loopback unless LAN access is explicitly required. For a trusted LAN only,
# set RADAR_DASHBOARD_BIND_HOST=0.0.0.0 and restrict TCP/3000 with the guest firewall.
RADAR_DASHBOARD_BIND_HOST=127.0.0.1
RADAR_DASHBOARD_PORT=3000
